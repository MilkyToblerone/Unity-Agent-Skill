{
  "permissions": {
    "deny": [
      "Edit(**/*.unity)",
      "Edit(**/*.prefab)",
      "Edit(**/*.meta)",
      "Edit(**/*.asset)",
      "Edit(**/*.mat)",
      "Edit(**/*.anim)",
      "Edit(**/*.controller)",
      "Edit(**/ProjectSettings/**)",
      "Edit(**/Packages/manifest.json)",
      "Edit(**/.claude/state/**)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/settings.json)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(unity eval *)",
      "Bash(unity command *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.ps1",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.ps1",
              "UserPromptSubmit"
            ]
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "next-step",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.ps1",
              "UserPromptExpansion"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.ps1",
              "PreToolUse"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.ps1",
              "PostToolUse"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "unity-architect",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate.ps1",
              "SubagentStop"
            ]
          }
        ]
      }
    ]
  }
}